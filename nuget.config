<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Ignore machine-level sources so every build restores from nuget.org only. Aspire's daily
         feed is added by the Aspire preview workflow (.github/workflows/aspire-preview.yml) for
         its own run, so regular builds never depend on it. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
