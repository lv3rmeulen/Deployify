<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Ignore machine-level sources so every build restores from these sources only. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Aspire's daily builds, for the Aspire preview workflow (tools/aspire-version.sh). -->
    <add key="aspire-daily" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet9/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <!-- Only Aspire packages may come from the daily feed; everything else from nuget.org.
         NuGet only uses the most specific matching pattern, so Aspire.* is listed under
         nuget.org too: otherwise released Aspire versions could only come from the daily feed. -->
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Aspire.*" />
    </packageSource>
    <packageSource key="aspire-daily">
      <package pattern="Aspire.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
