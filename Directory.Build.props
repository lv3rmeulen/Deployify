<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Warnings have been at zero since abdf0c9; keep it that way. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet vulnerability advisories stay warnings: a newly published advisory
         shouldn't break main on its own. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

    <!-- MinVer conventions-->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha</MinVerDefaultPreReleaseIdentifiers>
    <MinVerAutoIncrement>minor</MinVerAutoIncrement>

    <!-- Package metadata, shared by every package the release workflow publishes -->
    <Authors>lv3rmeulen</Authors>
    <Copyright>Copyright (c) 2026 by Luk Vermeulen. All Rights Reserved.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lv3rmeulen/Deployify</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lv3rmeulen/Deployify</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Reproducible builds -->
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="all" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>
</Project>
