{
  "Job": {
    "ID": "worker",
    "Name": "worker",
    "Namespace": "default",
    "Type": "service",
    "Datacenters": [
      "dc1"
    ],
    "Meta": {
      "deployify-managed": "true"
    },
    "TaskGroups": [
      {
        "Name": "worker",
        "Count": 1,
        "Update": {
          "MinHealthyTime": 30000000000,
          "HealthyDeadline": 600000000000,
          "ProgressDeadline": 900000000000,
          "AutoRevert": true
        },
        "Tasks": [
          {
            "Name": "worker",
            "Driver": "raw_exec",
            "Config": {
              "command": "local/worker",
              "args": [
                "--mode",
                "fast",
                "--api",
                "http://localhost:8080"
              ]
            },
            "Templates": [
              {
                "EmbeddedTmpl": "{{ $svc0 := \"\" }}{{ range nomadService 1 (env \"NOMAD_ALLOC_ID\") \"api\" }}{{ $svc0 = .Address }}{{ end -}}\nAPI_URL=http://{{ $svc0 }}:8080\n",
                "DestPath": "secrets/deployify.env",
                "Envvars": true,
                "ChangeMode": "restart"
              }
            ],
            "Resources": {
              "CPU": 256,
              "MemoryMB": 256
            }
          }
        ]
      }
    ]
  }
}
