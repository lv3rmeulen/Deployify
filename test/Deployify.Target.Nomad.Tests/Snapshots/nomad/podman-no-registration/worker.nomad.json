{
  "Job": {
    "ID": "worker",
    "Name": "worker",
    "Namespace": "default",
    "Type": "service",
    "Datacenters": [
      "dc1"
    ],
    "Meta": {
      "deployify-managed": "true"
    },
    "TaskGroups": [
      {
        "Name": "worker",
        "Count": 1,
        "Update": {
          "MinHealthyTime": 30000000000,
          "HealthyDeadline": 600000000000,
          "ProgressDeadline": 900000000000,
          "AutoRevert": true
        },
        "Tasks": [
          {
            "Name": "worker",
            "Driver": "podman",
            "Config": {
              "image": "registry.example.com/myapp/worker:1",
              "network_mode": "host",
              "args": [
                "--mode",
                "fast",
                "--api",
                "http://localhost:8080"
              ]
            },
            "Env": {
              "API_URL": "http://localhost:8080"
            },
            "Resources": {
              "CPU": 256,
              "MemoryMB": 256
            }
          }
        ]
      }
    ]
  }
}
