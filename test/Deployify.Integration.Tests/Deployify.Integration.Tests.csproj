    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Deployify.Integration.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Spectre.Console.Testing" />
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Deployify\Deployify.csproj" />
    <ProjectReference Include="..\..\src\Deployify.Core\Deployify.Core.csproj" />
    <ProjectReference Include="..\..\src\Deployify.Target.Nomad\Deployify.Target.Nomad.csproj" />
    <ProjectReference Include="..\..\src\Deployify.Target.Kubernetes\Deployify.Target.Kubernetes.csproj" />
    <ProjectReference Include="..\..\src\Deployify.Target.Compose\Deployify.Target.Compose.csproj" />
    <ProjectReference Include="..\..\src\Deployify.Target.AwsEcs\Deployify.Target.AwsEcs.csproj" />
    <ProjectReference Include="..\..\src\Deployify.Target.AzureContainerApps\Deployify.Target.AzureContainerApps.csproj" />
    <ProjectReference Include="..\..\src\Deployify.Target.NomadConsul\Deployify.Target.NomadConsul.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\FakeProcessRunner.cs" Link="Shared\FakeProcessRunner.cs" />
  </ItemGroup>

</Project>
