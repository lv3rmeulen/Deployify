{
  "FormatVersion": 1,
  "ActiveEnvironment": "prod",
  "Environments": {
    "prod": {
      "Target": "Compose",
      "ContainerRegistry": "registry.example.com/team",
      "ImageTag": "1.2.3",
      "OutputPath": "out",
      "ServiceOverrides": {},
      "IgnoreResources": [],
      "Parameters": {},
      "ContainerRuntime": "Podman",
      "DeployDashboard": true,
      "Dashboard": {
        "ImageTag": "latest",
        "Port": 19888,
        "OtlpPort": 19889,
        "BrowserToken": "env:DASH_TOKEN",
        "Cpu": "100m",
        "Memory": "128Mi"
      },
      "AppHostPath": "<dir>",
      "ContainerOs": "linux",
      "ContainerArch": "arm64",
      "DeployDapr": true,
      "Dapr": {
        "DaprVersion": "latest",
        "DaprHttpPort": 3600,
        "DaprGrpcPort": 50101,
        "ComponentsPath": "./components",
        "LogLevel": "info"
      },
      "Secrets": {
        "Backend": "Inline",
        "Vault": {
          "Mount": "secret",
          "PathPrefix": "deployify",
          "AuthMount": "kubernetes",
          "ManageAuth": true,
          "SecretsFileName": "appsettings.secrets.json",
          "AgentAnnotations": {}
        },
        "KeyVault": {
          "KubernetesIdentity": "WorkloadIdentity"
        },
        "References": {}
      },
      "TargetConfig": {
        "compose": {
          "ProjectName": "shopapp",
          "OutputPath": "compose-output",
          "GenerateMergedFile": true,
          "RestartPolicy": "always",
          "GenerateHealthChecks": false,
          "BasePort": 8080,
          "GenerateEnvFile": true,
          "GenerateProfiles": true,
          "Volumes": {},
          "BindMounts": {}
        }
      },
      "Protected": false,
      "Prune": false,
      "Sbom": {
        "Enabled": false,
        "Format": "Spdx",
        "Attest": true
      }
    }
  }
}