{
  "FormatVersion": 1,
  "ActiveEnvironment": "prod",
  "Environments": {
    "prod": {
      "Target": "CloudRun",
      "ImageTag": "latest",
      "OutputPath": "deployify-output",
      "ServiceOverrides": {},
      "IgnoreResources": [],
      "Parameters": {},
      "ContainerRuntime": "Docker",
      "DeployDashboard": false,
      "Dashboard": {
        "ImageTag": "latest",
        "Port": 18888,
        "OtlpPort": 18889,
        "Cpu": "100m",
        "Memory": "128Mi"
      },
      "AppHostPath": "<dir>",
      "ContainerOs": "linux",
      "ContainerArch": "x64",
      "DeployDapr": false,
      "Dapr": {
        "DaprVersion": "latest",
        "DaprHttpPort": 3500,
        "DaprGrpcPort": 50001,
        "LogLevel": "info"
      },
      "Secrets": {
        "Backend": "Inline",
        "Vault": {
          "Mount": "secret",
          "PathPrefix": "deployify",
          "AuthMount": "kubernetes",
          "ManageAuth": true,
          "SecretsFileName": "appsettings.secrets.json",
          "AgentAnnotations": {}
        },
        "KeyVault": {
          "KubernetesIdentity": "WorkloadIdentity"
        },
        "References": {}
      },
      "TargetConfig": {
        "cloudrun": {
          "ProjectId": "",
          "Region": "us-central1",
          "MinInstances": 0,
          "MaxInstances": 3,
          "Cpu": "1",
          "Memory": "512Mi",
          "InternalIngress": "internal",
          "AllowUnauthenticated": true,
          "VpcEgress": "private-ranges-only",
          "BasePort": 8080
        }
      },
      "Protected": false,
      "Prune": false,
      "Sbom": {
        "Enabled": false,
        "Format": "Spdx",
        "Attest": true
      },
      "Signing": {
        "Enabled": false
      }
    }
  }
}