{
  "FormatVersion": 1,
  "ActiveEnvironment": "prod",
  "Environments": {
    "prod": {
      "Target": "Host",
      "ImageTag": "latest",
      "OutputPath": "deployify-output",
      "ServiceOverrides": {},
      "IgnoreResources": [],
      "Parameters": {},
      "ContainerRuntime": "Docker",
      "DeployDashboard": false,
      "Dashboard": {
        "ImageTag": "latest",
        "Port": 18888,
        "OtlpPort": 18889,
        "Cpu": "100m",
        "Memory": "128Mi"
      },
      "AppHostPath": "<dir>",
      "ContainerOs": "linux",
      "ContainerArch": "x64",
      "DeployDapr": false,
      "Dapr": {
        "DaprVersion": "latest",
        "DaprHttpPort": 3500,
        "DaprGrpcPort": 50001,
        "LogLevel": "info"
      },
      "Secrets": {
        "Backend": "Inline",
        "Vault": {
          "Mount": "secret",
          "PathPrefix": "deployify",
          "AuthMount": "kubernetes",
          "ManageAuth": true,
          "SecretsFileName": "appsettings.secrets.json",
          "AgentAnnotations": {}
        },
        "KeyVault": {
          "KubernetesIdentity": "WorkloadIdentity"
        },
        "References": {}
      },
      "TargetConfig": {
        "host": {
          "Hosts": [],
          "Transport": "WinRm",
          "UseSsl": false,
          "KeepReleases": 3,
          "HealthPath": "/",
          "StartupSeconds": 10,
          "HostHealthTimeoutSeconds": 120,
          "SelfContained": true,
          "BasePort": 8080,
          "ListenAddress": "*",
          "ExternalHosts": {}
        }
      },
      "Protected": false,
      "Prune": false,
      "Sbom": {
        "Enabled": false,
        "Format": "Spdx",
        "Attest": true
      },
      "Signing": {
        "Enabled": false
      }
    }
  }
}