{
  "FormatVersion": 1,
  "ActiveEnvironment": "prod",
  "Environments": {
    "prod": {
      "Target": "Flux",
      "ImageTag": "latest",
      "OutputPath": "deployify-output",
      "ServiceOverrides": {},
      "IgnoreResources": [],
      "Parameters": {},
      "ContainerRuntime": "Docker",
      "DeployDashboard": false,
      "Dashboard": {
        "ImageTag": "latest",
        "Port": 18888,
        "OtlpPort": 18889,
        "Cpu": "100m",
        "Memory": "128Mi"
      },
      "AppHostPath": "<dir>",
      "ContainerOs": "linux",
      "ContainerArch": "x64",
      "DeployDapr": false,
      "Dapr": {
        "DaprVersion": "latest",
        "DaprHttpPort": 3500,
        "DaprGrpcPort": 50001,
        "LogLevel": "info"
      },
      "Secrets": {
        "Backend": "Inline",
        "Vault": {
          "Mount": "secret",
          "PathPrefix": "deployify",
          "AuthMount": "kubernetes",
          "ManageAuth": true,
          "SecretsFileName": "appsettings.secrets.json",
          "AgentAnnotations": {}
        },
        "KeyVault": {
          "KubernetesIdentity": "WorkloadIdentity"
        },
        "References": {}
      },
      "TargetConfig": {
        "kubernetes": {
          "NamespacePrefix": "prod",
          "GenerateIngress": false,
          "IngressClassName": "nginx",
          "CpuRequest": "100m",
          "CpuLimit": "500m",
          "MemoryRequest": "128Mi",
          "MemoryLimit": "512Mi",
          "DefaultReplicas": 1,
          "HealthCheckType": "tcp",
          "HealthCheckPath": "/health",
          "BasePort": 8080,
          "ImagePullSecrets": []
        },
        "gitops": {
          "RepoUrl": "",
          "Branch": "main",
          "Path": "deployify/prod",
          "AuthorName": "Deployify",
          "AuthorEmail": "deployify@localhost",
          "Push": true,
          "Register": true,
          "Wait": false,
          "WaitTimeoutSeconds": 300
        },
        "flux": {
          "Namespace": "flux-system",
          "CreateSource": true,
          "Interval": "1m",
          "Timeout": "5m",
          "Prune": true
        }
      },
      "Protected": false,
      "Prune": false,
      "Sbom": {
        "Enabled": false,
        "Format": "Spdx",
        "Attest": true
      },
      "Signing": {
        "Enabled": false
      }
    }
  }
}