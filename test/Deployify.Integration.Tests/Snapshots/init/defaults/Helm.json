{
  "FormatVersion": 1,
  "ActiveEnvironment": "prod",
  "Environments": {
    "prod": {
      "Target": "Helm",
      "ImageTag": "latest",
      "OutputPath": "deployify-output",
      "ServiceOverrides": {},
      "IgnoreResources": [],
      "Parameters": {},
      "ContainerRuntime": "Docker",
      "DeployDashboard": false,
      "Dashboard": {
        "ImageTag": "latest",
        "Port": 18888,
        "OtlpPort": 18889,
        "Cpu": "100m",
        "Memory": "128Mi"
      },
      "AppHostPath": "<dir>",
      "ContainerOs": "linux",
      "ContainerArch": "x64",
      "DeployDapr": false,
      "Dapr": {
        "DaprVersion": "latest",
        "DaprHttpPort": 3500,
        "DaprGrpcPort": 50001,
        "LogLevel": "info"
      },
      "Secrets": {
        "Backend": "Inline",
        "Vault": {
          "Mount": "secret",
          "PathPrefix": "deployify",
          "AuthMount": "kubernetes",
          "ManageAuth": true,
          "SecretsFileName": "appsettings.secrets.json",
          "AgentAnnotations": {}
        },
        "KeyVault": {
          "KubernetesIdentity": "WorkloadIdentity"
        },
        "References": {}
      },
      "TargetConfig": {
        "kubernetes": {
          "NamespacePrefix": "deployify",
          "GenerateIngress": false,
          "IngressClassName": "nginx",
          "CpuRequest": "100m",
          "CpuLimit": "500m",
          "MemoryRequest": "128Mi",
          "MemoryLimit": "512Mi",
          "DefaultReplicas": 1,
          "HealthCheckType": "tcp",
          "HealthCheckPath": "/health",
          "BasePort": 8080,
          "ImagePullSecrets": []
        },
        "helm": {
          "ChartVersion": "0.1.0",
          "HistoryMax": 10,
          "Wait": false,
          "Timeout": "5m"
        }
      },
      "Protected": false,
      "Prune": false
    }
  }
}