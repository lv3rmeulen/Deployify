{
  "FormatVersion": 1,
  "ActiveEnvironment": "prod",
  "Environments": {
    "prod": {
      "Target": "OvhCloud",
      "ContainerRegistry": "registry.example.com/team",
      "ImageTag": "1.2.3",
      "OutputPath": "out",
      "ServiceOverrides": {},
      "IgnoreResources": [],
      "Parameters": {},
      "ContainerRuntime": "Podman",
      "DeployDashboard": true,
      "Dashboard": {
        "ImageTag": "9.0",
        "Port": 19888,
        "OtlpPort": 19889,
        "BrowserToken": "env:DASH_TOKEN",
        "Cpu": "100m",
        "Memory": "128Mi"
      },
      "AppHostPath": "<dir>",
      "ContainerOs": "linux",
      "ContainerArch": "arm64",
      "DeployDapr": true,
      "Dapr": {
        "DaprVersion": "1.14",
        "DaprHttpPort": 3600,
        "DaprGrpcPort": 50101,
        "ComponentsPath": "./components",
        "ConfigPath": "./dapr.yaml",
        "LogLevel": "debug"
      },
      "Secrets": {
        "Backend": "Inline",
        "Vault": {
          "Mount": "secret",
          "PathPrefix": "deployify",
          "AuthMount": "kubernetes",
          "ManageAuth": true,
          "SecretsFileName": "appsettings.secrets.json",
          "AgentAnnotations": {}
        },
        "KeyVault": {
          "KubernetesIdentity": "WorkloadIdentity"
        },
        "References": {}
      },
      "TargetConfig": {
        "kubernetes": {
          "NamespacePrefix": "shop",
          "GenerateIngress": true,
          "IngressClassName": "nginx",
          "IngressBaseDomain": "apps.example.com",
          "CpuRequest": "100m",
          "CpuLimit": "500m",
          "MemoryRequest": "128Mi",
          "MemoryLimit": "512Mi",
          "DefaultReplicas": 1,
          "HealthCheckType": "tcp",
          "HealthCheckPath": "/health",
          "BasePort": 8080,
          "ImagePullSecrets": []
        },
        "ovhcloud": {
          "Endpoint": "ovh-ca",
          "ProjectId": "proj-1",
          "ClusterId": "cluster-1",
          "WaitForReady": true,
          "ReadyTimeoutSeconds": 600
        }
      },
      "Protected": false,
      "Prune": false,
      "Sbom": {
        "Enabled": false,
        "Format": "Spdx",
        "Attest": true
      },
      "Signing": {
        "Enabled": false
      }
    }
  }
}