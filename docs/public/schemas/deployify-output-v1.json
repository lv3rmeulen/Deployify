{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lv3rmeulen.github.io/Deployify/schemas/deployify-output-v1.json",
  "title": "Deployify --output json, schema version 1",
  "description": "The document plan, diff, drift, status, explain, promote and history write to stdout with --output json. Within schema version 1, properties are only added: consumers must ignore properties they don't know.",
  "type": "object",
  "required": [
    "schemaVersion",
    "command",
    "success",
    "exitCode",
    "error",
    "environment",
    "target",
    "diagnostics",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Raised only for a breaking change, in a major release."
    },
    "command": {
      "enum": [
        "plan",
        "diff",
        "drift",
        "status",
        "explain",
        "promote",
        "history"
      ]
    },
    "success": {
      "type": "boolean",
      "description": "True exactly when exitCode is 0."
    },
    "exitCode": {
      "type": "integer",
      "description": "The process exit code."
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "description": "Why the command failed: the first error in diagnostics. Null when success is true."
    },
    "environment": {
      "type": [
        "string",
        "null"
      ],
      "description": "The environment the command ran against (the --to environment for promote). Null when it failed before resolving one, and for drift --all, which lists its environments in the result."
    },
    "target": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/target"
        }
      ],
      "description": "The environment's deployment target. Null when the command failed before resolving one, and for drift --all."
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      },
      "description": "The info, warning and error messages the command reported, in order. Log lines aren't included."
    },
    "result": {
      "description": "The command's own document, or null when it failed before producing one. Its shape depends on command."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "const": "plan"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/plan"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "diff"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/diff"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "drift"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/drift"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "status"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/status"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "explain"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/explain"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "promote"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/promote"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "history"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/history"
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "severity": {
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The target ID as in the state file (Nomad, Kubernetes, …) or a plugin target's ID."
        },
        "name": {
          "type": "string",
          "description": "The target's display name."
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "severity",
        "message"
      ],
      "properties": {
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "create",
        "update",
        "delete",
        "unchanged",
        "unknown",
        "skipped",
        "upToDate",
        "deletesOnApply",
        "blocked",
        "blockedReason",
        "manifestFindings"
      ],
      "properties": {
        "create": {
          "$ref": "#/$defs/names",
          "description": "Services apply would create."
        },
        "update": {
          "$ref": "#/$defs/names",
          "description": "Services apply would update."
        },
        "delete": {
          "$ref": "#/$defs/names",
          "description": "Services on the target that are no longer in the manifest."
        },
        "unchanged": {
          "$ref": "#/$defs/names",
          "description": "Services known to match."
        },
        "unknown": {
          "type": "array",
          "description": "Services on the target that couldn't be compared. Never counted as unchanged.",
          "items": {
            "type": "object",
            "required": [
              "service",
              "reason"
            ],
            "properties": {
              "service": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "skipped": {
          "type": "array",
          "description": "Manifest resources Deployify won't deploy.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type",
              "reason"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "description": "The manifest resource type, e.g. azure.bicep.v0."
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "upToDate": {
          "type": "boolean",
          "description": "True only when create, update, delete and unknown are all empty."
        },
        "deletesOnApply": {
          "type": "boolean",
          "description": "True when apply removes the services under delete without --prune: the environment sets Prune, or the target is Compose."
        },
        "blocked": {
          "type": "boolean",
          "description": "True when apply would refuse because of the manifest findings (an error, or a warning with --strict). The exit code is then 1."
        },
        "blockedReason": {
          "$ref": "#/$defs/nullableString"
        },
        "manifestFindings": {
          "type": "array",
          "description": "What the manifest audit found about resources that won't be deployed and parameters without a value.",
          "items": {
            "type": "object",
            "required": [
              "resource",
              "type",
              "severity",
              "message"
            ],
            "properties": {
              "resource": {
                "type": "string"
              },
              "type": {
                "$ref": "#/$defs/nullableString"
              },
              "severity": {
                "$ref": "#/$defs/severity"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "diff": {
      "type": "object",
      "required": [
        "identical",
        "entries"
      ],
      "properties": {
        "identical": {
          "type": "boolean",
          "description": "True when every entry is unchanged."
        },
        "entries": {
          "type": "array",
          "description": "One entry per service, ordered added, removed, changed, unchanged, unknown.",
          "items": {
            "type": "object",
            "required": [
              "service",
              "kind",
              "field",
              "oldValue",
              "newValue",
              "reason"
            ],
            "properties": {
              "service": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "added",
                  "removed",
                  "changed",
                  "unchanged",
                  "unknown"
                ]
              },
              "field": {
                "$ref": "#/$defs/nullableString",
                "description": "What changed, when the target says (manifest, release, image, …)."
              },
              "oldValue": {
                "$ref": "#/$defs/nullableString",
                "description": "What the target has now, as the target reports it. For Kubernetes and Helm, null; the whole diff is in newValue. Secret values resolved during the run are masked as ****."
              },
              "newValue": {
                "$ref": "#/$defs/nullableString",
                "description": "What apply would set, as the target reports it. For Kubernetes and Helm, the rendered diff (kubectl diff, helm diff). Secret values resolved during the run are masked as ****."
              },
              "reason": {
                "$ref": "#/$defs/nullableString",
                "description": "Why the service couldn't be compared; set when kind is unknown."
              }
            }
          }
        }
      }
    },
    "drift": {
      "type": "object",
      "required": [
        "drifted",
        "environments"
      ],
      "description": "One entry per environment checked: the active one, --env, or every one with --all.",
      "properties": {
        "drifted": {
          "type": "boolean",
          "description": "True when at least one environment drifted (exit code 2)."
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "environment",
              "target",
              "status",
              "checkedAt",
              "reason",
              "deployed",
              "entries",
              "ignored",
              "fingerprint",
              "alert"
            ],
            "properties": {
              "environment": {
                "type": "string"
              },
              "target": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/target"
                  }
                ],
                "description": "Null when the environment couldn't be resolved."
              },
              "status": {
                "type": "string",
                "description": "inSync, drifted, unknown (some services couldn't be compared), error (the check couldn't run), notDeployed (no successful deploy recorded yet) or skipped (a deploy holds the lock, or drift.enabled is false). Open-ended: a minor release can add statuses."
              },
              "checkedAt": {
                "$ref": "#/$defs/timestamp"
              },
              "reason": {
                "$ref": "#/$defs/nullableString",
                "description": "Why the status is error, notDeployed or skipped."
              },
              "deployed": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/driftDeployed"
                  }
                ],
                "description": "The deploy the live state was compared with. Null when there is none."
              },
              "entries": {
                "type": "array",
                "description": "Every difference not ignored by drift.ignore, ordered missing, extra, changed, unknown.",
                "items": {
                  "$ref": "#/$defs/driftEntry"
                }
              },
              "ignored": {
                "type": "integer",
                "description": "Differences left out by drift.ignore."
              },
              "fingerprint": {
                "type": "string",
                "description": "Identifies what drifted; the same differences give the same fingerprint. Empty when nothing drifted."
              },
              "alert": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/driftAlert"
                  }
                ],
                "description": "The alert this check called for. Null when none was due, or with --no-notify."
              }
            }
          }
        }
      }
    },
    "driftDeployed": {
      "type": "object",
      "required": [
        "releaseId",
        "at",
        "tag",
        "commit",
        "actor",
        "runUrl"
      ],
      "properties": {
        "releaseId": {
          "$ref": "#/$defs/nullableString",
          "description": "The deploy's release record (deployify history). Null when the history is off."
        },
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "tag": {
          "$ref": "#/$defs/nullableString"
        },
        "commit": {
          "$ref": "#/$defs/nullableString"
        },
        "actor": {
          "$ref": "#/$defs/nullableString"
        },
        "runUrl": {
          "$ref": "#/$defs/nullableString",
          "description": "The CI run that deployed."
        }
      }
    },
    "driftEntry": {
      "type": "object",
      "required": [
        "service",
        "kind",
        "field",
        "live",
        "deployed",
        "reason"
      ],
      "properties": {
        "service": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "missing",
            "extra",
            "changed",
            "unknown"
          ],
          "description": "missing: deployed, no longer on the target. extra: on the target, not part of the deploy. changed: settings differ. unknown: the target couldn't compare it."
        },
        "field": {
          "$ref": "#/$defs/nullableString",
          "description": "What changed, when the target says, as in diff."
        },
        "live": {
          "$ref": "#/$defs/nullableString",
          "description": "The value on the target now, as the target reports it (diff's oldValue). For Kubernetes and Helm, null; the rendered diff is in deployed. Secrets are masked as ****."
        },
        "deployed": {
          "$ref": "#/$defs/nullableString",
          "description": "The value that was deployed, as the target reports it (diff's newValue). For Kubernetes and Helm, the rendered diff from live to deployed."
        },
        "reason": {
          "$ref": "#/$defs/nullableString",
          "description": "Why the service couldn't be compared; set when kind is unknown."
        }
      }
    },
    "driftAlert": {
      "type": "object",
      "required": [
        "event",
        "deliveries"
      ],
      "properties": {
        "event": {
          "type": "string",
          "description": "drifted, changed, reminder, resolved or failing. Open-ended."
        },
        "deliveries": {
          "type": "array",
          "description": "One per channel in drift.notify; empty when none are configured.",
          "items": {
            "type": "object",
            "required": [
              "channel",
              "type",
              "ok",
              "error"
            ],
            "properties": {
              "channel": {
                "type": "string",
                "description": "The channel's name, or its type when it has none."
              },
              "type": {
                "type": "string",
                "description": "slack, teams or webhook."
              },
              "ok": {
                "type": "boolean"
              },
              "error": {
                "$ref": "#/$defs/nullableString",
                "description": "Why the delivery failed. Never contains the webhook URL."
              }
            }
          }
        }
      }
    },
    "explain": {
      "type": "object",
      "required": [
        "services"
      ],
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "image",
              "imageTag",
              "count",
              "ports",
              "dependsOn",
              "details"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "image": {
                "$ref": "#/$defs/nullableString"
              },
              "imageTag": {
                "$ref": "#/$defs/nullableString"
              },
              "count": {
                "type": "integer",
                "description": "Instances (replicas) to run."
              },
              "ports": {
                "$ref": "#/$defs/names"
              },
              "dependsOn": {
                "$ref": "#/$defs/names"
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Target-specific facts (namespace, job name, CPU, …). The keys differ per target and aren't covered by the stability policy."
              }
            }
          }
        }
      }
    },
    "rolloutOperation": {
      "type": "string",
      "description": "rollout, destroy or prune. Open-ended: a minor release can add operations."
    },
    "rolloutState": {
      "type": "string",
      "description": "running, succeeded, failed, rollingBack, rolledBack or rollbackFailed. Open-ended: a minor release can add states."
    },
    "rolloutSummary": {
      "type": "object",
      "required": [
        "id",
        "operation",
        "target",
        "startedAt",
        "finishedAt",
        "state",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/rolloutOperation"
        },
        "target": {
          "type": "string"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "finishedAt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/timestamp"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/rolloutState"
        },
        "reason": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "rollouts",
        "rollout"
      ],
      "description": "Without --rollout, rollouts lists the most recent ones (newest first, up to --limit) and rollout is null. With --rollout, rollout is that one and rollouts is null.",
      "properties": {
        "rollouts": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/rolloutSummary"
              }
            }
          ]
        },
        "rollout": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/rollout"
            }
          ]
        }
      }
    },
    "history": {
      "type": "object",
      "required": [
        "releases"
      ],
      "description": "The environment's release history, newest first, up to --limit.",
      "properties": {
        "releases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/release"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "at",
        "outcome",
        "tag",
        "commit",
        "fromEnvironment",
        "actor",
        "actorSource",
        "runUrl",
        "rolloutId",
        "summary",
        "deployifyVersion",
        "images"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "description": "publish, promote, deploy or rollback. Open-ended: a minor release can add kinds."
        },
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "outcome": {
          "type": "string",
          "description": "succeeded, rolledBack or failed. Open-ended: a minor release can add outcomes."
        },
        "tag": {
          "$ref": "#/$defs/nullableString",
          "description": "The image tag of the release. Null when it covers no built images (a rollback)."
        },
        "commit": {
          "$ref": "#/$defs/nullableString",
          "description": "The commit the images were built from, when known."
        },
        "fromEnvironment": {
          "$ref": "#/$defs/nullableString",
          "description": "For a promote: the environment the digests came from."
        },
        "actor": {
          "$ref": "#/$defs/nullableString",
          "description": "Who ran it: a CI user name, or the local account name outside CI."
        },
        "actorSource": {
          "$ref": "#/$defs/nullableString",
          "description": "Where actor came from: a CI variable such as GITHUB_ACTOR, or local."
        },
        "runUrl": {
          "$ref": "#/$defs/nullableString",
          "description": "A link to the CI run."
        },
        "rolloutId": {
          "$ref": "#/$defs/nullableString",
          "description": "The rollout journal of a health-gated deploy, or the rollout a rollback undid."
        },
        "summary": {
          "$ref": "#/$defs/nullableString",
          "description": "What happened, for people; set when the release didn't succeed and for rollbacks."
        },
        "deployifyVersion": {
          "$ref": "#/$defs/nullableString"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "service",
              "repository",
              "tag",
              "digest"
            ],
            "properties": {
              "service": {
                "type": "string"
              },
              "repository": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              },
              "digest": {
                "$ref": "#/$defs/nullableString",
                "description": "Null when the image isn't pinned by digest."
              }
            }
          }
        }
      }
    },
    "promote": {
      "type": "object",
      "required": [
        "from",
        "to",
        "imageTag",
        "dryRun",
        "promoted",
        "recorded",
        "copyTool",
        "images"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "imageTag": {
          "type": "string"
        },
        "dryRun": {
          "type": "boolean"
        },
        "promoted": {
          "type": "boolean",
          "description": "True when the digests are recorded in the target environment. Always false with --dry-run."
        },
        "recorded": {
          "type": "integer",
          "description": "How many digests this run newly recorded."
        },
        "copyTool": {
          "type": [
            "string",
            "null"
          ],
          "description": "crane, skopeo or docker when images had to be copied to the target's registry; null when none had to be."
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "service",
              "repository",
              "tag",
              "digest",
              "sourceRepository",
              "sourceTag",
              "needsCopy",
              "alreadyPromoted",
              "copied",
              "problem"
            ],
            "properties": {
              "service": {
                "type": "string"
              },
              "repository": {
                "type": "string",
                "description": "Where the target environment pulls the image from."
              },
              "tag": {
                "type": "string"
              },
              "digest": {
                "$ref": "#/$defs/nullableString"
              },
              "sourceRepository": {
                "type": "string"
              },
              "sourceTag": {
                "type": "string"
              },
              "needsCopy": {
                "type": "boolean",
                "description": "True when the target uses another repository, so the image is copied there first."
              },
              "alreadyPromoted": {
                "type": "boolean"
              },
              "copied": {
                "type": "boolean",
                "description": "True when this run copied the image."
              },
              "problem": {
                "$ref": "#/$defs/nullableString",
                "description": "Why the image can't be promoted. Any problem means nothing is promoted."
              },
              "attestationsCopied": {
                "type": ["integer", "null"],
                "description": "How many cosign attestations this run copied to the target registry with the image: 0 when the target already had them all. Null when attestations aren't copied for this image."
              },
              "signaturesCopied": {
                "type": ["integer", "null"],
                "description": "How many cosign signatures this run copied to the target registry with the image: 0 when the target already had them all. Null when signatures aren't copied for this image."
              },
              "signatureVerified": {
                "type": ["boolean", "null"],
                "description": "With --require-signature: true when the image's signature verified where the target pulls it from, false when that wasn't checked (a dry-run, or the run stopped first). Null without --require-signature."
              }
            }
          }
        }
      }
    },
    "rollout": {
      "type": "object",
      "required": [
        "id",
        "operation",
        "target",
        "startedAt",
        "finishedAt",
        "state",
        "reason",
        "waves",
        "services",
        "events",
        "journal"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/rolloutOperation"
        },
        "target": {
          "type": "string"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "finishedAt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/timestamp"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/rolloutState"
        },
        "reason": {
          "$ref": "#/$defs/nullableString"
        },
        "waves": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/names"
          },
          "description": "The services in each wave, in deploy order."
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "state",
              "before",
              "revision",
              "restoredRevision",
              "detail"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "description": "pending, deploying, verifying, healthy, failed, revertedByPlatform, rolledBack, rollbackFailed, deleted or deleteFailed. Open-ended: a minor release can add states."
              },
              "before": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "required": [
                      "existed",
                      "revision"
                    ],
                    "properties": {
                      "existed": {
                        "type": "boolean"
                      },
                      "revision": {
                        "$ref": "#/$defs/nullableString"
                      }
                    }
                  }
                ],
                "description": "What ran before the rollout; null when it wasn't recorded."
              },
              "revision": {
                "$ref": "#/$defs/nullableString"
              },
              "restoredRevision": {
                "$ref": "#/$defs/nullableString"
              },
              "detail": {
                "$ref": "#/$defs/nullableString"
              },
              "strategy": {
                "$ref": "#/$defs/nullableString",
                "description": "For a canary or blue-green rollout: the strategy as configured, e.g. \"canary 10% 5m → 100%\". Null or left out for a rolling update."
              },
              "candidate": {
                "$ref": "#/$defs/nullableString",
                "description": "For a canary or blue-green rollout: the new revision started next to the old one."
              },
              "trafficPercent": {
                "type": ["integer", "null"],
                "description": "The share of the traffic the candidate got last, in percent."
              },
              "previewUrl": {
                "$ref": "#/$defs/nullableString",
                "description": "Where the candidate could be tried out before it got traffic, when the platform gives an address."
              }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at",
              "service",
              "message"
            ],
            "properties": {
              "at": {
                "$ref": "#/$defs/timestamp"
              },
              "service": {
                "$ref": "#/$defs/nullableString"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "journal": {
          "type": "string",
          "description": "Path of the rollout journal file."
        }
      }
    }
  }
}
