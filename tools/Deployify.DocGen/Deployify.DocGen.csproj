<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Writes the CLI reference pages for the docs site from the real command tree.
    See docs/README.md for how to run it; CI fails when the committed pages differ.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Deployify\Deployify.csproj" />
  </ItemGroup>

</Project>
