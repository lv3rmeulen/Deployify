<Project>
  <!-- Keeps this sample independent of the repository's build settings, so it can be copied out as is. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Samples run with plain `dotnet run`, without the Aspire CLI bundle. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
</Project>
