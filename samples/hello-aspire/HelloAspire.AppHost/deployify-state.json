{
  "ActiveEnvironment": "local",
  "Environments": {
    "local": {
      "Target": "Compose",
      "ImageTag": "local",
      "OutputPath": "deployify-output",
      "TargetConfig": {
        "compose": {
          "ProjectName": "hello-aspire"
        }
      }
    }
  },
  "Targets": {
    "target": "Flux",
    "flux": {
      "namespace": "flux-system",
      "sourceName": null,
      "createSource": true,
      "secretRef": null,
      "interval": "1m",
      "timeout": "5m",
      "prune": true
    }
  }
}
