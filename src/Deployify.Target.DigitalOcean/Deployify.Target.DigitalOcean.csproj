<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The DigitalOcean App Platform target, shipped as an out-of-process plugin built on
    Deployify.Plugin.Sdk. Deployify finds it as deployify-target-digitalocean, either in a
    plugins folder or on PATH after `dotnet tool install -g Deployify.Target.DigitalOcean`.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>deployify-target-digitalocean</AssemblyName>
    <RootNamespace>Deployify.Target.DigitalOcean</RootNamespace>
    <Description>Deployify target plugin for DigitalOcean App Platform: deploys an Aspire app as one App Platform app, with Postgres and Redis mapped to DigitalOcean Managed Databases.</Description>
    <PackageId>Deployify.Target.DigitalOcean</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>deployify-target-digitalocean</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deployify.Plugin.Sdk\Deployify.Plugin.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deployify.Target.DigitalOcean.Tests" />
  </ItemGroup>

</Project>
