<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Deployify.Target.Host</RootNamespace>
    <Description>Deployify deployment target for plain machines: each project runs as a systemd unit on Linux or a Windows service on Windows.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Deployify.Core\Deployify.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Scripts\deployify-host.sh" LogicalName="Deployify.Target.Host.deployify-host.sh" />
    <EmbeddedResource Include="Scripts\deployify-host.ps1" LogicalName="Deployify.Target.Host.deployify-host.ps1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Deployify.Target.Host.Tests" />
  </ItemGroup>

</Project>
