<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>deployify</AssemblyName>
    <RootNamespace>Deployify</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>deployify</ToolCommandName>
    <PackageId>deployify</PackageId>
    <Version>1.0.0-alpha14</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright © 2026 by Luk Vermeulen, All Rights Reserved</Copyright>
    <Description>Deploy .NET Aspire AppHost projects to any platform — Nomad, Kubernetes, Docker Compose, AWS ECS, Azure Container Apps, and Nomad + Consul Connect.</Description>
    <Authors>Luk Vermeulen</Authors>
    <PackageIcon>deployify-icon.png</PackageIcon>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/lv3rmeulen/Deployify</RepositoryUrl>
    <PackageProjectUrl>https://github.com/lv3rmeulen/Deployify</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\deployify-icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.*" />
    <PackageReference Include="Spectre.Console" Version="0.49.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deployify.Core\Deployify.Core.csproj" />
    <ProjectReference Include="..\Deployify.Target.Nomad\Deployify.Target.Nomad.csproj" />
    <ProjectReference Include="..\Deployify.Target.Kubernetes\Deployify.Target.Kubernetes.csproj" />
    <ProjectReference Include="..\Deployify.Target.Compose\Deployify.Target.Compose.csproj" />
    <ProjectReference Include="..\Deployify.Target.AwsEcs\Deployify.Target.AwsEcs.csproj" />
    <ProjectReference Include="..\Deployify.Target.AzureContainerApps\Deployify.Target.AzureContainerApps.csproj" />
    <ProjectReference Include="..\Deployify.Target.NomadConsul\Deployify.Target.NomadConsul.csproj" />
  </ItemGroup>

</Project>
