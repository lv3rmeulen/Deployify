<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>deployify</AssemblyName>
    <RootNamespace>Deployify</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>deployify</ToolCommandName>
    <PackageId>deployify</PackageId>
    <Version>1.0.0</Version>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deployify.Core\Deployify.Core.csproj" />
    <ProjectReference Include="..\Deployify.Target.Nomad\Deployify.Target.Nomad.csproj" />
    <ProjectReference Include="..\Deployify.Target.Kubernetes\Deployify.Target.Kubernetes.csproj" />
    <ProjectReference Include="..\Deployify.Target.Compose\Deployify.Target.Compose.csproj" />
    <ProjectReference Include="..\Deployify.Target.AwsEcs\Deployify.Target.AwsEcs.csproj" />
    <ProjectReference Include="..\Deployify.Target.AzureContainerApps\Deployify.Target.AzureContainerApps.csproj" />
    <ProjectReference Include="..\Deployify.Target.NomadConsul\Deployify.Target.NomadConsul.csproj" />
    <ProjectReference Include="..\Deployify.Target.Helm\Deployify.Target.Helm.csproj" />
    <ProjectReference Include="..\Deployify.Target.GitOps\Deployify.Target.GitOps.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deployify.Integration.Tests" />
  </ItemGroup>

</Project>
