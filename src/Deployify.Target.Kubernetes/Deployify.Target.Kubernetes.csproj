<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Deployify.Target.Kubernetes</RootNamespace>
    <Description>Deployify deployment target for Kubernetes.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Deployify.Core\Deployify.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Deployify.Target.Kubernetes.Tests" />
    <InternalsVisibleTo Include="Deployify.Target.Helm" />
    <InternalsVisibleTo Include="Deployify.Target.Helm.Tests" />
    <InternalsVisibleTo Include="Deployify.Target.GitOps" />
    <InternalsVisibleTo Include="Deployify.Target.GitOps.Tests" />
    <InternalsVisibleTo Include="Deployify.Target.OvhCloud" />
    <InternalsVisibleTo Include="Deployify.Target.OvhCloud.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared with the other targets that write YAML. -->
    <Compile Include="..\Shared\Yaml\YamlWriter.cs" Link="Yaml\YamlWriter.cs" />
  </ItemGroup>

</Project>
